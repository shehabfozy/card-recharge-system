# Railway يوفر DATABASE_URL تلقائياً عند إضافة PostgreSQL Plugin
# لا حاجة لإضافته يدوياً إذا استخدمت Plugin Railway
DATABASE_URL="postgresql://username:password@host:5432/dbname?schema=public"

# JWT Secret (غيّره لقيمة عشوائية قوية)
JWT_SECRET="your-super-secret-key-change-this-2026"
JWT_EXPIRES_IN="7d"

# المنفذ (Railway يحدده تلقائياً)
PORT=3000

# بيئة العمل
NODE_ENV="production"

# بيانات المدير الافتراضي
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
